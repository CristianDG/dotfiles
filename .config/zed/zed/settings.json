// Zed settings
//
// For information on how to configure Zed, see the Zed
// documentation: https://zed.dev/docs/configuring-zed
//
// To see all of Zed's default settings without changing your
// custom settings, run `zed: open default settings` from the
// command palette (cmd-shift-p / ctrl-shift-p)
{
  "toolbar": {
    "code_actions": false
  },
  "auto_signature_help": false,
  "auto_update": false,
  "debugger": {
    "button": false
  },
  "proxy": "",
  "cli_default_open_behavior": "new_window",
  "tasks": {
    "prefer_lsp": true,
  },
  "vim": {
    "gdefault": true,
    "use_smartcase_find": true,
  },
  "buffer_font_weight": 400.0,
  "agent_buffer_font_size": 14.0,
  "agent_ui_font_size": 16.0,
  "ui_font_weight": 400.0,
  "preferred_line_length": 120,
  "soft_wrap": "editor_width",
  "terminal": {
    "font_size": 15.0,
  },
  "completions": {
    "words": "enabled",
  },
  "collaboration_panel": {
    "dock": "left",
  },
  "languages": {
    "PHP": {
      "language_servers": ["emmet-language-server", "!phpantom_lsp", "!phpactor", "intelephense"],
    },
  },
  "lsp": {
    "intelephense": {
      "settings": {
        "environment": { "phpVersion": "7.3.33" },
        "stubs": [
          "calendar", "Core", "ctype", "date", "ds", "exif", "FFI", "fileinfo", "filter",
          "ftp", "gettext", "hash", "iconv", "json", "lexbor", "libxml", "openssl", "pcntl",
          "pcre", "PDO", "Phar", "posix", "random", "readline", "Reflection", "session",
          "shmop", "sockets", "sodium", "SPL", "standard", "sysvmsg", "sysvsem", "sysvshm",
          "tokenizer", "uri", "Zend OPcache", "zlib", "mbstring"
        ],
      },
    },
  },
  "agent": {
    "sidebar_side": "left",
    "default_model": {
      "provider": "google",
      "model": "gemini-2.5-flash",
      "enable_thinking": true,
    },
    "dock": "right",
    "favorite_models": [],
    "model_parameters": [],
  },
  "git_panel": {
    "dock": "left",
  },
  "remove_trailing_whitespace_on_save": false,
  "format_on_save": "off",
  "outline_panel": {
    "dock": "left",
  },
  "project_panel": {
    "dock": "left",
  },
  "base_keymap": "VSCode",
  "icon_theme": {
    "mode": "dark",
    "light": "Zed (Default)",
    "dark": "Zed (Default)",
  },
  "vim_mode": true,
  "ui_font_size": 16.0,
  "buffer_font_size": 13.5,
  "theme": {
    "mode": "dark",
    "light": "One Light",
    "dark": "One Dark",
  },
  "experimental.theme_overrides": {
    "syntax": {
      "comment": {
        "color": "#717a82"
      },
    }
  },
}
