{
  "->": {
    "prefix": ".",
    "body": ["->$0"],
  },
  "pp": {
    "body": ["<?php", "declare(strict_types=1);", ""],
  },
  "<php": {
    "body": ["<?php $0 ?>"],
  },
  "<echo": {
    "body": ["<?php echo $0 ?>"],
  },
  "<foreach": {
    "body": [
      "<?php foreach ($0) { ?> ",
      "<?php } /* endforeach */ ?>"
    ],
  },
  "<else" : {
    "body": [
      "<?php } else { ?>",
    ],
  },
  "<if" : {
    "body": [
      "<?php if ($0) { ?> ",
      "<?php } /* endif */ ?>"
    ],
  }
}
